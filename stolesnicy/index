<script>
(function(){
  const form=document.getElementById('calcForm');
  const lengthInput=document.getElementById('length');
  const lengthUnknown=document.getElementById('lengthUnknown');
  const summaryEl=document.getElementById('resultSummary');
  const titleEl=document.getElementById('resultTitle');
  const listEl=document.getElementById('resultList');
  const hiddenSummary=document.getElementById('calcHiddenSummary');
  const resultPanel=document.getElementById('calcResultPanel');
  const leadForm=document.getElementById('calcLeadForm');
  const decors={
    unknown:{label:'Пока не знаю'},
    basic:{label:'Однотонный или мелкий песок'},
    speckled:{label:'С выраженными вкраплениями'},
    marble:{label:'Под мрамор'}
  };
  const shapes={
    straight:{label:'Прямая'},
    l:{label:'Г-образная'},
    p:{label:'П-образная'},
    custom:{label:'Нестандартная',custom:true}
  };
  function checked(name){return form.querySelector('input[name="'+name+'"]:checked')}
  function updateActive(){form.querySelectorAll('.choice').forEach(l=>{const i=l.querySelector('input');l.classList.toggle('active',!!i&&i.checked)})}
  function getState(){
    const shape=shapes[checked('shape')?.value||'straight'];
    const decor=decors[checked('decor')?.value||'unknown'];
    const raw=String(lengthInput.value||'').replace(',','.').trim();
    const hasLength=!lengthUnknown.checked&&raw!==''&&!Number.isNaN(parseFloat(raw));
    const length=hasLength?Math.max(.1,parseFloat(raw)):0;
    const sink=checked('sink');
    const extras=[...form.querySelectorAll('.calc-option-group input[type="checkbox"]:checked')].map(i=>i.dataset.name);
    return {shape,decor,hasLength,length,lengthUnknown:lengthUnknown.checked,sink,extras};
  }
  function buildRows(state){
    const rows=[['Форма',state.shape.label]];
    rows.push(['Длина',state.lengthUnknown?'Не знаю размеры':(state.hasLength?state.length.toFixed(1).replace('.',',')+' м':'Не указана')]);
    rows.push(['Декор',state.decor.label]);
    if(state.sink&&state.sink.value!=='none')rows.push(['Мойка',state.sink.dataset.name]);
    state.extras.forEach(name=>rows.push(['Дополнительно',name]));
    return rows;
  }
  let quizFinalized=false;
  function render(finalized=quizFinalized){
    updateActive();
    const state=getState();
    const rows=buildRows(state);
    listEl.innerHTML=rows.map(r=>'<div class="result-line"><span>'+r[0]+'</span><b>'+r[1]+'</b></div>').join('');
    hiddenSummary.value=rows.map(r=>r.join(': ')).join('; ');
    if(finalized){
      quizFinalized=true;
      titleEl.textContent='Данные для расчета готовы';
      summaryEl.textContent='Проверьте параметры проекта и оставьте номер телефона. Мы подготовим расчет по этим данным.';
      resultPanel.classList.add('quiz-complete');
      leadForm.classList.remove('is-hidden');leadForm.classList.add('is-visible');
    }else{
      titleEl.textContent='Ответьте на 4 вопроса';
      summaryEl.textContent='Выбранные параметры появятся здесь и автоматически добавятся в заявку.';
      resultPanel.classList.remove('quiz-complete');
    }
  }
  function validateLength(){
    if(lengthUnknown.checked||lengthInput.value)return true;
    lengthInput.focus();lengthInput.setCustomValidity('Укажите примерную длину или выберите «Не знаю размеры»');lengthInput.reportValidity();lengthInput.setCustomValidity('');return false;
  }
  function completeQuiz(){
    if(!validateLength())return;
    render(true);
    resultPanel.classList.add('mobile-visible');
    resultPanel.scrollIntoView({behavior:'smooth',block:'start'});
    window.dataLayer=window.dataLayer||[];window.dataLayer.push({event:'quiz_complete',quiz_summary:hiddenSummary.value});
  }
  lengthUnknown.addEventListener('change',()=>{lengthInput.disabled=lengthUnknown.checked;if(lengthUnknown.checked)lengthInput.value='';render()});
  form.addEventListener('change',e=>{
    const target=e.target;
    if(target.matches('.calc-option-group input[type="checkbox"]')){
      const unknown=[...form.querySelectorAll('.calc-option-group input[type="checkbox"]')].find(i=>i.dataset.name==='Пока не знаю комплектацию');
      const others=[...form.querySelectorAll('.calc-option-group input[type="checkbox"]')].filter(i=>i!==unknown);
      if(target===unknown&&unknown.checked)others.forEach(i=>i.checked=false);
      if(target!==unknown&&target.checked&&unknown)unknown.checked=false;
    }
    render();
  });
  form.addEventListener('input',()=>render());render(false);
  document.getElementById('quizComplete')?.addEventListener('click',completeQuiz);

  const steps=[...form.querySelectorAll('.calc-step')];let current=0;
  const next=document.getElementById('calcNext'),prev=document.getElementById('calcPrev'),progressText=document.getElementById('calcProgressText'),progressBar=document.getElementById('calcProgressBar');
  function isMobile(){return window.matchMedia('(max-width:760px)').matches}
  function showStep(index){
    current=Math.max(0,Math.min(index,steps.length-1));
    steps.forEach((s,i)=>s.classList.toggle('active',!isMobile()||i===current));
    if(progressText)progressText.textContent='Шаг '+(current+1)+' из '+steps.length;
    if(progressBar)progressBar.style.width=((current+1)/steps.length*100)+'%';
    if(prev)prev.style.visibility=current===0?'hidden':'visible';
    if(next)next.textContent=current===steps.length-1?'Получить расчет стоимости':'Далее';
    if(isMobile())resultPanel.classList.remove('mobile-visible');else resultPanel.classList.add('mobile-visible');
  }
  next?.addEventListener('click',()=>{
    if(current===1&&!validateLength())return;
    if(current<steps.length-1){showStep(current+1);steps[current].scrollIntoView({behavior:'smooth',block:'start'})}
    else completeQuiz();
  });
  prev?.addEventListener('click',()=>showStep(current-1));
  window.addEventListener('resize',()=>showStep(current));showStep(0);

  const modes={
    calc:{eyebrow:'Заявка на расчет',title:'Получите расчет стоимости столешницы',lead:'Оставьте контакты, и мы уточним размеры, подскажем подходящий материал и подготовим расчет.',notice:'Фото кухни или чертеж помогут сделать расчет точнее, но отправить заявку можно и без них.',button:'Получить расчет стоимости',context:'Расчет стоимости'},
    measure:{eyebrow:'Бесплатный замер',title:'Вызовите замерщика с образцами',lead:'Специалист приедет на объект, покажет материалы, поможет выбрать оттенок и снимет точные размеры.',notice:'После замера согласуем комплектацию, стоимость и сроки изготовления.',button:'Вызвать замерщика',context:'Вызов замерщика'},
