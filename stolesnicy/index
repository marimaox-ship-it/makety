  function setMode(mode){const m=modes[mode]||modes.calc;document.getElementById('formEyebrow').textContent=m.eyebrow;document.getElementById('formTitle').textContent=m.title;document.getElementById('formLead').textContent=m.lead;document.getElementById('formNotice').textContent=m.notice;document.getElementById('formButton').textContent=m.button;document.getElementById('formContext').value=m.context}
  document.querySelectorAll('a[data-form-mode]').forEach(a=>a.addEventListener('click',()=>setMode(a.dataset.formMode)));

